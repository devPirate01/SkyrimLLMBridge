# =============================================================================
# SkyrimLLMBridge - Environment Configuration Template
# Copy this file to '.env' in the same folder and configure your local settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Active LLM Provider
# Options: 'koboldcpp' (Recommended for local GGUF), 'unsloth', or 'openwebui'
# -----------------------------------------------------------------------------
LLM_PROVIDER=koboldcpp

# -----------------------------------------------------------------------------
# Provider 1: KoboldCpp (Recommended for local GGUF inference)
# -----------------------------------------------------------------------------
# KOBOLDCPP_URL must point to the KoboldCpp HTTP API endpoint (including /v1).
# - If KoboldCpp is running on the SAME computer:
#     KOBOLDCPP_URL=http://127.0.0.1:5001/v1
# - If KoboldCpp is running on a SECOND machine on your local network:
#     KOBOLDCPP_URL=http://<IP-OF-YOUR-SERVER>:5001/v1   (e.g., http://192.168.1.100:5001/v1)
KOBOLDCPP_URL=http://127.0.0.1:5001/v1
KOBOLDCPP_MODEL=koboldcpp

# -----------------------------------------------------------------------------
# Skyrim SKSE StorageUtil Data Directory
# -----------------------------------------------------------------------------
# Directory where Skyrim Papyrus (via PapyrusUtil StorageUtil) writes request.json
# and reads response.json.
#
# Standard Steam Default:
SKYRIM_DATA_DIR=C:\Program Files (x86)\Steam\steamapps\common\Skyrim Special Edition\Data\SKSE\Plugins\StorageUtilData\CompanionLLM
#
# Mod Organizer 2 (MO2) Users:
# If using MO2, PapyrusUtil may write files to your MO2 overwrite folder instead:
# SKYRIM_DATA_DIR=C:\Modding\MO2\overwrite\SKSE\Plugins\StorageUtilData\CompanionLLM
# or inside the mod folder:
# SKYRIM_DATA_DIR=C:\Modding\MO2\mods\Deterministic LLM Dialogue Bridge\SKSE\Plugins\StorageUtilData\CompanionLLM
#
# GOG / Custom Install Example:
# SKYRIM_DATA_DIR=D:\Games\Skyrim Special Edition\Data\SKSE\Plugins\StorageUtilData\CompanionLLM

# -----------------------------------------------------------------------------
# Provider 2: Unsloth Desktop / Studio (Alternative local provider)
# -----------------------------------------------------------------------------
UNSLOTH_URL=http://127.0.0.1:8888/v1
UNSLOTH_TOKEN=
UNSLOTH_MODEL=gemma-4-E2B-it-unsloth-bnb-4bit

# -----------------------------------------------------------------------------
# Provider 3: Open WebUI / Remote OpenAI-compatible Endpoint
# -----------------------------------------------------------------------------
OPENWEBUI_URL=http://127.0.0.1:3000/api
OPENWEBUI_TOKEN=your_jwt_or_bearer_token_here
OPENWEBUI_MODEL=llama3.3:latest

# -----------------------------------------------------------------------------
# Telemetry & Session Metadata
# -----------------------------------------------------------------------------
SESSION_ID=eval_session_001
PARTICIPANT_ID=researcher
EXPERIMENTAL_GROUP=EVALUATION
DIALOGUE_CONDITION=LLM
