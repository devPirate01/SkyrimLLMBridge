# =============================================================================
# SkyrimLLMBridge - Environment Configuration Template
# Copy this file to .env and configure it for your local runtime environment.
# DO NOT commit your actual .env file containing private endpoints or tokens!
# =============================================================================

# Active LLM Provider: 'unsloth', 'koboldcpp', or 'openwebui'
LLM_PROVIDER=unsloth

# -----------------------------------------------------------------------------
# Skyrim SKSE StorageUtil Data Directory
# Directory where Skyrim Papyrus writes request.json and reads response.json.
# Adjust to match your local Skyrim install or mock test folder:
# -----------------------------------------------------------------------------
SKYRIM_DATA_DIR=H:\Games\TES - Skyrim - Anniversary Edition\Data\SKSE\Plugins\StorageUtilData\CompanionLLM

# -----------------------------------------------------------------------------
# Provider 1: Unsloth Desktop / Studio (Recommended for local edge execution)
# -----------------------------------------------------------------------------
UNSLOTH_URL=http://127.0.0.1:8888/v1
UNSLOTH_TOKEN=your_unsloth_api_token_here
UNSLOTH_MODEL=gemma-4-E2B-it-unsloth-bnb-4bit

# -----------------------------------------------------------------------------
# Provider 2: KoboldCpp (Alternative local GGUF server)
# -----------------------------------------------------------------------------
KOBOLDCPP_URL=http://127.0.0.1:5001/v1
KOBOLDCPP_MODEL=koboldcpp

# -----------------------------------------------------------------------------
# Provider 3: Open WebUI / Remote OpenAI-compatible Endpoint
# -----------------------------------------------------------------------------
OPENWEBUI_URL=https://your-openwebui-endpoint:port
OPENWEBUI_TOKEN=your_jwt_or_bearer_token_here
OPENWEBUI_MODEL=llama3.3:latest

# -----------------------------------------------------------------------------
# Telemetry & Session Metadata
# -----------------------------------------------------------------------------
SESSION_ID=eval_session_001
PARTICIPANT_ID=researcher
EXPERIMENTAL_GROUP=EVALUATION
DIALOGUE_CONDITION=LLM
